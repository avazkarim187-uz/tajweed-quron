{
  "expo": {
    "name": "AI Tajweed Ustoz",
    "slug": "tajweed-ustoz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tajweed",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B5E20"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tajweed.ustoz"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B5E20"
      },
      "package": "com.tajweed.ustoz"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "platforms": ["ios", "android"],
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "Ovozni yozib olish uchun mikrofon kerak"
        }
      ]
    ]
  }
}
